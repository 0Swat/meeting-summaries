@rendermode InteractiveServer
@using System.Net
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<button class="btn btn-outline-secondary icon-nav-btn settings-btn"
        @onclick="Open" title="Ustawienia">
    <i class="bi bi-gear"></i>
</button>

@if (_open)
{
    <div class="offcanvas-backdrop fade show" @onclick="Close"></div>
    <div class="offcanvas offcanvas-start show">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Ustawienia</h5>
            <button class="btn-close" @onclick="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-4">

            <section>
                <h6 class="fw-semibold mb-3">Zmiana hasła</h6>
                @if (_pwdSuccess)
                {
                    <div class="alert alert-success py-2">Hasło zostało zmienione.</div>
                }
                @if (_pwdError is not null)
                {
                    <div class="alert alert-danger py-2">@_pwdError</div>
                }
                <div class="mb-2">
                    <label class="form-label small">Aktualne hasło</label>
                    <input type="password" class="form-control form-control-sm"
                           @bind="_currentPwd" @bind:event="oninput" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Nowe hasło</label>
                    <input type="password" class="form-control form-control-sm"
                           @bind="_newPwd" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">Powtórz nowe hasło</label>
                    <input type="password" class="form-control form-control-sm"
                           @bind="_newPwd2" @bind:event="oninput" />
                </div>
                <button class="btn btn-primary btn-sm w-100"
                        @onclick="ChangePassword"
                        disabled="@_pwdLoading">
                    @if (_pwdLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Zmień hasło
                </button>
            </section>

            <hr />

            <section class="mt-auto">
                <h6 class="fw-semibold text-danger mb-2">Usuń konto</h6>
                <p class="text-muted small mb-3">
                    Trwale usuwa konto i wszystkie powiązane spotkania. Tej operacji nie można cofnąć.
                </p>
                @if (!_confirmDelete)
                {
                    <button class="btn btn-outline-danger btn-sm w-100"
                            @onclick="() => _confirmDelete = true">
                        Usuń konto
                    </button>
                }
                else
                {
                    <p class="text-danger small fw-semibold">Na pewno chcesz usunąć konto?</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger btn-sm flex-grow-1"
                                @onclick="DeleteAccount"
                                disabled="@_deleteLoading">
                            @if (_deleteLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Tak, usuń
                        </button>
                        <button class="btn btn-secondary btn-sm"
                                @onclick="() => _confirmDelete = false">
                            Anuluj
                        </button>
                    </div>
                }
            </section>

        </div>
    </div>
}

<style>
    .settings-btn {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 1000;
        width: 40px;
        height: 40px;
        padding: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.15);
        transition: transform .15s ease;
    }

    .settings-btn:hover {
        transform: rotate(30deg);
    }

    .offcanvas-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.4);
        z-index: 1040;
    }

    .offcanvas {
        z-index: 1045;
    }
</style>

@code {
    private bool _open;
    private bool _confirmDelete;

    private string _currentPwd = string.Empty;
    private string _newPwd = string.Empty;
    private string _newPwd2 = string.Empty;
    private string? _pwdError;
    private bool _pwdSuccess;
    private bool _pwdLoading;
    private bool _deleteLoading;

    private void Open()
    {
        _open = true;
        _pwdError = null;
        _pwdSuccess = false;
        _confirmDelete = false;
        _currentPwd = _newPwd = _newPwd2 = string.Empty;
    }

    private void Close() => _open = false;

    private async Task ChangePassword()
    {
        _pwdError = null;
        _pwdSuccess = false;

        if (string.IsNullOrWhiteSpace(_currentPwd) || string.IsNullOrWhiteSpace(_newPwd))
        {
            _pwdError = "Wszystkie pola są wymagane.";
            return;
        }
        if (_newPwd.Length < 4)
        {
            _pwdError = "Nowe hasło musi mieć co najmniej 4 znaki.";
            return;
        }
        if (_newPwd != _newPwd2)
        {
            _pwdError = "Nowe hasła nie są identyczne.";
            return;
        }

        _pwdLoading = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/auth/password",
                new { CurrentPassword = _currentPwd, NewPassword = _newPwd });

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _pwdError = await response.Content.ReadAsStringAsync();
                return;
            }
            response.EnsureSuccessStatusCode();
            _pwdSuccess = true;
            _currentPwd = _newPwd = _newPwd2 = string.Empty;
        }
        catch (Exception ex)
        {
            _pwdError = ex.Message;
        }
        finally
        {
            _pwdLoading = false;
        }
    }

    private async Task DeleteAccount()
    {
        _deleteLoading = true;
        try
        {
            var response = await Http.DeleteAsync("api/auth/account");
            response.EnsureSuccessStatusCode();
            await JS.InvokeVoidAsync("storage.set", "jwt", "");
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _confirmDelete = false;
            _deleteLoading = false;
            StateHasChanged();
            _ = ex;
        }
    }
}
